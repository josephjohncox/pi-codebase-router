{
  "name": "pi-codebase-router",
  "version": "0.4.0",
  "description": "Index-first routing for Pi: prefer the opencode-codebase-index semantic index over grep/shell, with guardrails, cb* prompts, a workflow skill, and optional session-start / after-write auto-indexing.",
  "type": "module",
  "license": "MIT",
  "author": "Joseph Cox <abovemind@gmail.com>",
  "homepage": "https://github.com/josephjohncox/pi-codebase-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephjohncox/pi-codebase-router.git"
  },
  "bugs": {
    "url": "https://github.com/josephjohncox/pi-codebase-router/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "codebase-index",
    "opencode-codebase-index",
    "semantic-search",
    "grep",
    "routing",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "docs",
    "skills",
    "prompts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "opencode-codebase-index": ">=0.38.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "opencode-codebase-index": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
